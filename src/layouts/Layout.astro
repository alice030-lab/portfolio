---
import "../styles/global.css";
import { getLang, href, altHref, htmlLang, t } from "../i18n";
const lang = getLang(Astro.url);
const {
  title = t(lang, "Alice Office — 品牌與編輯設計", "Alice Office — Brand & Editorial Design"),
  description = t(lang, "吳芝淩的設計實踐：品牌識別、包裝、產品介面。", "The design practice of Alice Wu: brand identity, packaging and product interfaces."),
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const pathNoLang = lang === "en" ? (path.replace(/^\/en(\/|$)/, "/") || "/") : path;
const isActive = (p: string) => pathNoLang === p || (p !== "/" && pathNoLang.startsWith(p));
const link = (p: string) => href(lang, p);
const siteOrigin = "https://alice030-lab.github.io";
const pageUrl = `${siteOrigin}${base}${path}`;
const ogImage = `${siteOrigin}${base}/images/og-work.jpg`;
const switchHref = altHref(lang, Astro.url);
const zhUrl = `${siteOrigin}${href("zh", pathNoLang)}`;
const enUrl = `${siteOrigin}${href("en", pathNoLang)}`;
---
<!doctype html>
<html lang={htmlLang(lang)}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === "en" ? "en_US" : "zh_TW"} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="alternate" hreflang="zh-Hant" href={zhUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={zhUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,700;1,9..144,700&family=Inter:wght@400;500;700&family=Noto+Serif+TC:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Memo collage loader — visible until window.load + min 1.6s -->
  <div id="book-loader" class="book-loader" aria-hidden="true">
    <div class="memo-stack">
      <div class="memo m1"></div>
      <div class="memo m2"></div>
      <div class="memo m3"></div>
      <div class="memo m4"></div>
      <div class="memo m5"></div>
      <div class="memo m6"></div>
    </div>
    <div class="book-loader-text">{t(lang, "整理設計師的便條…", "Tidying the designer's notes…")}</div>
  </div>
  <script is:inline>
    (function () {
      const loader = document.getElementById("book-loader");
      if (!loader) return;
      const start = Date.now();
      // First page of a visit shows the full intro; later pages only flash it briefly.
      let seen = false;
      try { seen = sessionStorage.getItem("ao-loader") === "1"; sessionStorage.setItem("ao-loader", "1"); } catch (e) {}
      const minMs = seen ? 350 : 1600;
      let hidden = false;
      const hide = () => {
        if (hidden) return;
        hidden = true;
        const elapsed = Date.now() - start;
        const wait = Math.max(0, minMs - elapsed);
        setTimeout(() => {
          loader.classList.add("is-hidden");
          setTimeout(() => loader.remove(), 700);
        }, wait);
      };
      // Ready = page structure parsed + fonts in (so text doesn't jump).
      // Images keep loading behind/after the loader instead of holding it up.
      const whenDom = (fn) => document.readyState === "loading"
        ? document.addEventListener("DOMContentLoaded", fn, { once: true }) : fn();
      whenDom(() => {
        const fonts = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
        Promise.race([fonts, new Promise(r => setTimeout(r, 1500))]).then(hide);
      });
      window.addEventListener("load", hide, { once: true });
      // Fallback: never block more than 4 seconds
      setTimeout(hide, 4000);
    })();
  </script>

  <header class="site-header">
    <div class="inner">
      <a href={link("/")} class="brand">Alice Office<small>{t(lang, "吳芝淩", "Alice Wu")}</small></a>
      <nav class="nav">
        <a href={link("/")} class={isActive("/") ? "active" : ""}>{t(lang, "首頁", "Home")}</a>
        <a href={link("/work")} class={isActive("/work") ? "active" : ""}>{t(lang, "作品", "Work")}</a>
        {/* <a href={link("/about")} class={isActive("/about") ? "active" : ""}>{t(lang, "關於", "About")}</a> */}
        {/* <a href={link("/pricing")} class={isActive("/pricing") ? "active" : ""}>{t(lang, "方案", "Pricing")}</a> */}
        {/* <a href={link("/contact")} class={isActive("/contact") ? "active" : ""}>{t(lang, "聯絡", "Contact")}</a> */}
        <a href={switchHref} class="lang-switch" hreflang={lang === "en" ? "zh-Hant" : "en"} lang={lang === "en" ? "zh-Hant" : "en"} aria-label={t(lang, "Switch to English", "切換為中文")}>
          <span class={lang === "zh" ? "on" : ""}>中</span><span class="lang-sep">/</span><span class={lang === "en" ? "on" : ""}>EN</span>
        </a>
      </nav>
    </div>
  </header>

  <script is:inline>
    (function () {
      const h = document.querySelector(".site-header");
      const set = () => document.documentElement.style.setProperty("--header-h", (h ? h.offsetHeight : 72) + "px");
      set();
      window.addEventListener("resize", set);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(set);

      // Hide the header while scrolling down, bring it back on any scroll up.
      const root = document.documentElement;
      let lastY = window.scrollY, ticking = false;
      const update = () => {
        ticking = false;
        const y = Math.max(0, window.scrollY);
        const dy = y - lastY;
        if (Math.abs(dy) < 6) return;
        const hh = h ? h.offsetHeight : 72;
        if (dy > 0 && y > hh) root.classList.add("header-hidden");
        else if (dy < 0) root.classList.remove("header-hidden");
        lastY = y;
      };
      window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      if (h) h.addEventListener("focusin", () => root.classList.remove("header-hidden"));
    })();
  </script>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="inner">
      <div class="big">
        {lang === "en"
          ? <>Let's make<br/><em style="font-style:italic;color:#6b6b6b">design worth a closer look.</em></>
          : <>一起做出<br/><em style="font-style:italic;color:#6b6b6b">值得細看的設計。</em></>}
      </div>
      <div class="meta">
        <span>© {new Date().getFullYear()} Alice Office</span>
        <span>{t(lang, "台北 · 台灣", "Taipei · Taiwan")}</span>
        <a href="mailto:hello@aliceoffice.studio">hello@aliceoffice.studio</a>
      </div>
    </div>
  </footer>

  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
    }, { threshold: 0, rootMargin: "0px 0px -10% 0px" });
    document.querySelectorAll(".reveal").forEach(el => io.observe(el));
  </script>
</body>
</html>
