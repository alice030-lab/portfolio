---
import Layout from "../../layouts/Layout.astro";
import { works as worksZh } from "../../data/works";
import { categories as categoriesZh, type GalleryItem, type GalleryDemo } from "../../data/gallery";
import { localize, href, type Lang } from "../../i18n";
const { lang } = Astro.props as { lang: Lang };
const works = localize(worksZh, lang);
const categories = localize(categoriesZh, lang);
const L = (p: string) => href(lang, p);
const ui = {
  zh: { title: "作品 — Alice Office", eyebrow: "— 作品集", lead: "分類整理的作品集，依主題切換瀏覽。", pieces: "件", piece: "件", openSite: "連到網站查看 ↗", back: "← 返回 作品理念", approach: "作品理念", emptyA: "這件作品的詳細思考還沒整理上來。歡迎直接", emptyLink: "聊聊看", emptyB: "。",
    nextHint: "繼續往下滑，接著看", swipe: "左右滑動看下一頁", expand: "展開完整長圖 ↓", collapse: "收合長圖 ↑", casesName: "包裝設計", casesDesc: "需要完整脈絡說明的長篇案例。", casesPhi: "包裝設計需要從結構、平面到插畫一次完成 — 在貨架上、手中、與手機螢幕上都站得住的產品而做。\n\n擅長處理在地品牌、文創、農特產類案件，強調誠實傳達產品本身，不過度包裝成文創樣板。" },
  en: { title: "Work — Alice Office", eyebrow: "— Portfolio", lead: "The portfolio organised by category — switch topics to browse.", pieces: "pieces", piece: "piece", openSite: "Open the site ↗", back: "← Back to approach", approach: "Approach", emptyA: "The thinking behind this piece isn't written up yet. Feel free to ", emptyLink: "get in touch", emptyB: ".",
    nextHint: "Keep scrolling for", swipe: "Swipe for the next page", expand: "Show the full image ↓", collapse: "Collapse ↑", casesName: "Packaging", casesDesc: "Long-form cases that need the full context.", casesPhi: "Packaging has to be completed in one pass — structure, graphics and illustration — for products that must hold up on the shelf, in the hand and on a phone screen.\n\nI work mostly with local brands, cultural products and agricultural specialties, and insist on conveying the product honestly rather than over-packaging it into a cultural-creative template." },
}[lang];

type Tab = {
  id: string;
  name: string;
  desc: string;
  philosophy?: string;
  catName: string;
  catTag: string;
  type: "images" | "demos" | "cases" | "mixed";
  images?: GalleryItem[];
  demos?: GalleryDemo[];
};

const tabs: Tab[] = [];
for (const c of categories) {
  if (c.subsections) {
    c.subsections.forEach((sub, i) => {
      tabs.push({
        id: `${c.key}-${i}`,
        name: sub.title,
        desc: sub.note ?? c.desc,
        philosophy: c.philosophy,
        catName: c.name,
        catTag: c.tagline,
        type: "images",
        images: sub.images,
      });
    });
  } else if (c.demos && c.images) {
    tabs.push({ id: c.key, name: c.name, desc: c.desc, philosophy: c.philosophy, catName: c.name, catTag: c.tagline, type: "mixed", demos: c.demos, images: c.images });
  } else if (c.demos) {
    tabs.push({ id: c.key, name: c.name, desc: c.desc, philosophy: c.philosophy, catName: c.name, catTag: c.tagline, type: "demos", demos: c.demos });
  } else if (c.images) {
    tabs.push({ id: c.key, name: c.name, desc: c.desc, philosophy: c.philosophy, catName: c.name, catTag: c.tagline, type: "images", images: c.images });
  }
}
const count = (t: Tab) =>
  t.type === "demos" ? t.demos!.length
    : t.type === "cases" ? works.length
    : t.type === "mixed" ? t.demos!.length + t.images!.length
    : t.images!.length;
tabs.push({
  id: "cases",
  name: ui.casesName,
  desc: ui.casesDesc,
  philosophy: ui.casesPhi,
  catName: "Case Studies",
  catTag: "— Projects",
  type: "cases",
});
---
<Layout title={ui.title}>
  <section class="container hero" style="padding-bottom: 24px;">
    <div class="eyebrow">{ui.eyebrow}</div>
    <h1>{lang === "en" ? <>All <em>work</em></> : <>完整<em>作品</em></>}</h1>
    <p class="lead">{ui.lead}</p>
  </section>

  <div class="work-layout">
    <aside class="work-tabs-vertical" role="tablist">
      {tabs.map((t, i) => (
        <button class={`vtab ${i === 0 ? "active" : ""}`} data-tab={t.id} role="tab" aria-selected={i === 0 ? "true" : "false"}>
          <span class="vtab-num">{String(i + 1).padStart(2, "0")}</span>
          <span class="vtab-name">{t.name}</span>
        </button>
      ))}
    </aside>

    <main class="work-content">
      {tabs.map((t, i) => (
        <section class={`tab-pane ${i === 0 ? "active" : ""}`} id={t.id} role="tabpanel">
          <div class="section-head" style="padding-top: 0;">
            <div>
              <div class="eyebrow" style="margin-bottom: 10px;">{t.catTag} · {t.catName}</div>
              <h2>{t.name}</h2>
            </div>
            <span class="num">— {count(t)} {count(t) === 1 ? ui.piece : ui.pieces}</span>
          </div>

          {(t.type === "demos" || t.type === "mixed") && t.demos && (
            <div class="demo-grid">
              {t.demos.map((d, di) => (
                <article class="demo-card" data-img={`${t.id}-demo-${di}`}>
                  <div class={`demo-frame ${d.slides ? "demo-frame--showcase" : ""}`} style={`aspect-ratio: ${d.ratio ?? "16 / 9"};`}>
                    {d.slides ? (
                      <div class="showcase-stack" data-showcase>
                        {d.slides.map((s, si) => (
                          <figure class="showcase-page-item" data-slide={si}>
                            {s.kind === "video"
                              ? <video src={s.src} muted loop playsinline preload="metadata" aria-label={`${s.page} ${s.title}`}></video>
                              : <img src={s.src} alt={`${s.page} ${s.title}`} loading={si === 0 ? "eager" : "lazy"} />}
                          </figure>
                        ))}
                      </div>
                    ) : d.image ? (
                      <a href={d.link ?? d.src} target="_blank" rel="noopener noreferrer" class="demo-shot-link">
                        <img src={d.image} alt={d.title} loading="lazy" />
                        <span class="demo-shot-cta">{ui.openSite}</span>
                      </a>
                    ) : (
                      <>
                        <iframe src={d.src} loading="lazy" title={d.title} sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
                        {d.mobileImage && <img class="demo-mobile-shot" src={d.mobileImage} alt={d.title} loading="lazy" decoding="async" />}
                        <a class="demo-open-link" href={d.link ?? d.src} target="_blank" rel="noopener noreferrer"><span>{ui.openSite}</span></a>
                      </>
                    )}
                  </div>
                  {d.slides && (
                    <div class="showcase-counter" aria-hidden="true">
                      <span class="showcase-swipe">← {ui.swipe} →</span>
                      <span><b data-showcase-cur>01</b> / {String(d.slides.length).padStart(2, "0")}</span>
                    </div>
                  )}
                  <div class="demo-meta">
                    <span class="tag">{d.tag}</span>
                    <h3>{d.title}</h3>
                    {d.desc && <p>{d.desc}</p>}
                  </div>
                </article>
              ))}
            </div>
          )}
          {t.type === "mixed" && t.images && (
            <div class="case-image-stack">
              {t.images.map((im, ii) => (
                <figure class="case-image" data-img={`${t.id}-img-${ii}`}>
                  <div class="frame">
                    {im.src.endsWith(".mp4") || im.src.endsWith(".webm")
                      ? <video src={im.src} data-lazy-video loop muted playsinline preload="none"></video>
                      : <img src={im.src} alt={im.caption ?? t.name} loading="lazy" decoding="async" />}
                  </div>
                  <button type="button" class="case-expand" aria-expanded="false" data-more={ui.expand} data-less={ui.collapse}>{ui.expand}</button>
                  {im.caption && <figcaption>{im.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
          {t.type === "cases" && (
            <div class="featured">
              {works.map((w) => (
                <a href={L(`/work/${w.slug}`)} class={`work-card ${w.span ?? ""}`}>
                  <div class="frame"><img src={w.cover} alt={w.title} loading="lazy" /></div>
                  <div class="meta">
                    <span class="tag">{w.tag}</span>
                    <span class="title">{w.title}</span>
                    <span class="year">{w.year}</span>
                  </div>
                </a>
              ))}
            </div>
          )}
          {t.type === "images" && t.images && (
            <div class="gallery-grid">
              {t.images.map((im, ii) => (
                <figure class="gallery-item" data-img={`${t.id}-img-${ii}`}>
                  <div class="frame">
                    {im.src.endsWith(".mp4") || im.src.endsWith(".webm")
                      ? <video src={im.src} data-lazy-video loop muted playsinline preload="none"></video>
                      : <img src={im.src} alt={im.caption ?? t.name} loading="lazy" decoding="async" />}
                  </div>
                  {im.caption && <figcaption>{im.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
          {i < tabs.length - 1 && (
            <div class="pane-next" aria-hidden="true">
              <span class="pane-next-arrow">↓</span>
              <span>{ui.nextHint} <b>{String(i + 2).padStart(2, "0")} {tabs[i + 1].name}</b></span>
            </div>
          )}
        </section>
      ))}
    </main>

    <aside class="work-philosophy">
      {/* Category-level philosophy (default per tab) */}
      {tabs.map((t, i) => (
        <article class={`phi ${i === 0 ? "active" : ""}`} data-pane={t.id}>
          <div class="phi-eyebrow">{t.catTag}</div>
          <h3 class="phi-title">{ui.approach}</h3>
          {t.philosophy && t.philosophy.split("\n\n").map(p => <p>{p}</p>)}
          <p class="phi-desc">{t.desc}</p>
        </article>
      ))}
      {/* Per-image philosophy panes — shown when an image is clicked */}
      {tabs.map(t => (
        <>
          {t.images?.map((im, ii) => (
            <article class="phi phi-item" data-pane={`${t.id}-img-${ii}`} data-parent={t.id}>
              <button class="phi-back" type="button">{ui.back}</button>
              <div class="phi-eyebrow">{t.catTag}</div>
              <h3 class="phi-title">{im.caption}</h3>
              {im.note ? im.note.split("\n\n").map(p => <p>{p}</p>) : <p class="phi-empty">{ui.emptyA}<a href={L("/contact")}>{ui.emptyLink}</a>{ui.emptyB}</p>}
            </article>
          ))}
          {t.demos?.map((d, di) => (
            <article class="phi phi-item" data-pane={`${t.id}-demo-${di}`} data-parent={t.id}>
              <button class="phi-back" type="button">{ui.back}</button>
              <div class="phi-eyebrow">{t.catTag}</div>
              <h3 class="phi-title">{d.title}</h3>
              <p class="phi-tag-line">{d.tag}</p>
              {d.desc && <p>{d.desc}</p>}
            </article>
          ))}
        </>
      ))}
    </aside>
  </div>

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll(".vtab");
      const panes = document.querySelectorAll(".tab-pane");
      const phis = document.querySelectorAll(".phi");

      const showPhi = (key) => {
        phis.forEach(p => p.classList.toggle("active", p.dataset.pane === key));
      };
      const showItems = (key) => {
        document.querySelectorAll("[data-img].is-active").forEach(el => el.classList.remove("is-active"));
        const el = document.querySelector(`[data-img="${key}"]`);
        if (el) el.classList.add("is-active");
      };

      // Tab switch — also reset philosophy to category default
      const headerH = () => (document.querySelector(".site-header")?.offsetHeight || 72);
      const layoutTop = () => {
        const layout = document.querySelector(".work-layout");
        return Math.max(0, (layout ? layout.getBoundingClientRect().top + window.scrollY : 0) - headerH() + 1);
      };
      buttons.forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = btn.getAttribute("data-tab");
          // Phone: the tab bar scrolls sideways — keep the current tab in view
          const rail = btn.parentElement;
          if (rail && rail.scrollWidth > rail.clientWidth + 4) {
            rail.scrollTo({ left: btn.offsetLeft - (rail.clientWidth - btn.offsetWidth) / 2, behavior: e.isTrusted ? "smooth" : "auto" });
          }
          // Tapped while deep inside another tab → start the new one from its top
          if (e.isTrusted && window.scrollY > layoutTop()) window.scrollTo({ top: layoutTop(), behavior: "auto" });
          buttons.forEach(b => {
            const on = b === btn;
            b.classList.toggle("active", on);
            b.setAttribute("aria-selected", on ? "true" : "false");
          });
          panes.forEach(p => p.classList.toggle("active", p.id === target));
          showPhi(target);
          document.querySelectorAll("[data-img].is-active").forEach(el => el.classList.remove("is-active"));
        });
      });

      // Click on image / demo card → show its philosophy
      document.querySelectorAll("[data-img]").forEach(el => {
        el.addEventListener("click", (e) => {
          // don't hijack iframe inside demo-card
          if (el.classList.contains("demo-card") && e.target.closest("iframe")) return;
          // don't hijack links inside cards
          if (e.target.closest("a") && !el.contains(e.target.closest("a"))) return;
          const key = el.getAttribute("data-img");
          showPhi(key);
          showItems(key);
        });
      });

      // Back button on per-image philosophy
      document.querySelectorAll(".phi-back").forEach(btn => {
        btn.addEventListener("click", () => {
          const parent = btn.closest(".phi")?.dataset.parent;
          if (parent) {
            showPhi(parent);
            document.querySelectorAll("[data-img].is-active").forEach(el => el.classList.remove("is-active"));
          }
        });
      });

      // Showcase windows — stacked pages in a scrolling frame; videos loop while visible
      document.querySelectorAll("[data-showcase]").forEach(sc => {
        const frame = sc.closest(".demo-frame");
        const videos = Array.from(sc.querySelectorAll("video"));
        const inFrame = new Map();
        const frameOnScreen = { v: false };
        const sync = () => {
          videos.forEach(v => {
            v.muted = true; // some browsers ignore the attribute; muted is required for autoplay
            const show = frameOnScreen.v && inFrame.get(v);
            if (show) v.play().catch(() => {}); else v.pause();
          });
        };
        // If the browser blocked autoplay (Safari low-power mode, autoplay settings…),
        // retry as soon as the visitor interacts with the page.
        ["pointerdown", "touchstart", "wheel", "keydown", "scroll"].forEach(ev =>
          window.addEventListener(ev, sync, { passive: true })
        );
        frame.addEventListener("scroll", sync, { passive: true });
        // Page counter (phone: pages are swiped sideways)
        const counter = sc.closest(".demo-card")?.querySelector("[data-showcase-cur]");
        const items = sc.querySelectorAll(".showcase-page-item");
        const updateCounter = () => {
          if (!counter || !items.length) return;
          const sideways = frame.scrollWidth > frame.clientWidth + 4;
          const i = sideways
            ? Math.round(frame.scrollLeft / frame.clientWidth)
            : Math.round(frame.scrollTop / (items[0].offsetHeight || 1));
          counter.textContent = String(Math.max(1, Math.min(items.length, i + 1))).padStart(2, "0");
        };
        frame.addEventListener("scroll", updateCounter, { passive: true });
        window.addEventListener("resize", updateCounter);
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver((entries) => {
            entries.forEach(en => inFrame.set(en.target, en.isIntersecting));
            sync();
          }, { root: frame, threshold: 0.25 });
          videos.forEach(v => { inFrame.set(v, false); io.observe(v); });
          new IntersectionObserver((entries) => {
            entries.forEach(en => { frameOnScreen.v = en.isIntersecting; });
            sync();
          }, { threshold: 0.1 }).observe(frame);
        } else {
          videos.forEach(v => v.play().catch(() => {}));
        }
      });

      // Gallery videos: nothing is downloaded until the video is actually on screen
      (function () {
        const vids = document.querySelectorAll("video[data-lazy-video]");
        if (!vids.length) return;
        if (!("IntersectionObserver" in window)) { vids.forEach(v => { v.muted = true; v.play().catch(() => {}); }); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach(en => {
            const v = en.target;
            v.muted = true;
            if (en.isIntersecting) v.play().catch(() => {}); else v.pause();
          });
        }, { threshold: 0.15 });
        vids.forEach(v => io.observe(v));
      })();

      // Phone: long case images open collapsed; a button expands them to full length
      document.querySelectorAll(".case-image").forEach(fig => {
        const btn = fig.querySelector(".case-expand");
        const frame = fig.querySelector(".frame");
        const media = frame && frame.querySelector("img, video");
        if (!btn || !frame || !media) return;
        const measure = () => {
          if (fig.classList.contains("is-expanded")) return;
          fig.classList.toggle("is-short", media.offsetHeight <= frame.clientHeight + 2);
        };
        media.addEventListener("load", measure);
        window.addEventListener("resize", measure);
        // Images can finish loading while their tab is hidden (height 0) — re-measure
        // whenever the media's rendered size changes, e.g. when the tab is shown.
        if ("ResizeObserver" in window) new ResizeObserver(measure).observe(media);
        measure();
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = fig.classList.toggle("is-expanded");
          btn.textContent = open ? btn.dataset.less : btn.dataset.more;
          btn.setAttribute("aria-expanded", open ? "true" : "false");
          if (!open) fig.scrollIntoView({ block: "start", behavior: "auto" });
        });
      });

      // Auto-advance: when the whole page (footer included) is scrolled to the very bottom
      // and the visitor keeps scrolling down, move on to the next tab.
      (function () {
        const tabButtons = Array.from(buttons);
        let acc = 0, lock = false, touchY = null;
        const atBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        const insideScroller = (t) => t && t.closest && t.closest(".demo-frame--showcase, .case-image .frame");
        const goNext = () => {
          if (lock) return;
          const i = tabButtons.findIndex(b => b.classList.contains("active"));
          if (i < 0 || i >= tabButtons.length - 1) return;
          lock = true; acc = 0;
          const nextBtn = tabButtons[i + 1];
          nextBtn.click();
          history.replaceState(null, "", "#" + nextBtn.getAttribute("data-tab"));
          window.scrollTo({ top: layoutTop(), behavior: "smooth" });
          setTimeout(() => { lock = false; }, 1400);
        };
        window.addEventListener("wheel", (e) => {
          if (e.deltaY <= 0 || !atBottom() || insideScroller(e.target)) { acc = 0; return; }
          acc += e.deltaY;
          if (acc > 140) goNext();
        }, { passive: true });
        window.addEventListener("touchstart", (e) => { touchY = e.touches[0].clientY; }, { passive: true });
        window.addEventListener("touchmove", (e) => {
          if (touchY == null || !atBottom() || insideScroller(e.target)) return;
          if (touchY - e.touches[0].clientY > 90) { touchY = null; goNext(); }
        }, { passive: true });
        window.addEventListener("touchend", () => { touchY = null; }, { passive: true });
      })();

      const hash = window.location.hash.replace("#", "");
      if (hash) {
        const btn = document.querySelector(`.vtab[data-tab="${hash}"]`);
        if (btn) btn.click();
      }
    })();
  </script>
</Layout>
